generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PM
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime  @default(now())

  createdProjects Project[]      @relation("PMProjects")
  assignedTasks   Task[]         @relation("AssignedTasks")
  activityLogs    ActivityLog[]
  notifications   Notification[]

  @@index([role])
}

model Client {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id          String   @id @default(uuid())
  name        String
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  createdById String
  createdBy   User     @relation("PMProjects", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  tasks        Task[]
  activityLogs ActivityLog[]

  @@index([createdById])
  @@index([clientId])
}

model Task {
  id           String     @id @default(uuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])
  title        String
  description  String?
  assignedToId String?
  assignedTo   User?      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?
  isOverdue    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@index([priority])
}

model ActivityLog {
  id         String   @id @default(uuid())
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  fromStatus String?
  toStatus   String?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([taskId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}
